# -*- mode: python ; coding: utf-8 -*-
# build/app.spec
# Generated by: pyinstaller --windowed --name PlaylistConverter --collect-all PySide6 main.py
# Then moved to build/ and edited to add Info.plist settings, hiddenimports, and target_arch.
#
# Build command: pyinstaller build/app.spec
# Output: dist/PlaylistConverter.app

from PyInstaller.utils.hooks import collect_all

datas = []
binaries = []
hiddenimports = []
tmp_ret = collect_all('PySide6')
datas += tmp_ret[0]; binaries += tmp_ret[1]; hiddenimports += tmp_ret[2]

# D-07: Ensure sqlcipher3 binding is bundled (Pitfall 3 / Assumption A4 mitigation)
# hiddenimports ensures PyInstaller includes the sqlcipher3 package.
# If the .so binary is still missing after build, add it explicitly to binaries= above.
hiddenimports += ['sqlcipher3', 'pyrekordbox']

a = Analysis(
    ['../main.py'],
    pathex=['..'],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='PlaylistConverter',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,  # None = Universal Binary (x86_64 + arm64); lipo broken on this dev machine
    codesign_identity=None,
    entitlements_file=None,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name='PlaylistConverter',
)
app = BUNDLE(
    coll,
    name='PlaylistConverter.app',
    icon=None,
    bundle_identifier='com.example.playlist-converter',
    info_plist={
        'NSRequiresAquaSystemAppearance': False,   # D-09: follow macOS dark/light mode
        'CFBundleDisplayName': 'Playlist Converter',
        'CFBundleShortVersionString': '0.1.0',
        'NSHighResolutionCapable': True,
        'LSMinimumSystemVersion': '14.0',
    },
)
